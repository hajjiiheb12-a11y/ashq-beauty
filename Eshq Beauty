  message += "*الولاية:* " + encodeURIComponent(governorate) + "%0A";
  message += "*العنوان:* " + encodeURIComponent(address) + "%0A%0A";

  message += "*المنتجات:*%0A";

  cart.forEach(item => {

    const p = products.find(x => x.id === item.id);

    message +=
      "• " +
      encodeURIComponent(p.name) +
      " × " +
      item.qty +
      " = " +
      (p.price * item.qty).toFixed(2) +
      " د.ت%0A";

  });

  const subtotal = cart.reduce((sum,item) => {

    const p = products.find(x => x.id === item.id);

    return sum + (p.price * item.qty);

  },0);

  const shipping = subtotal >= 80 ? 0 : 8;
  const total = subtotal + shipping;

  message += "%0A*المجموع:* " +
    subtotal.toFixed(2) +
    " د.ت%0A";

  message += "*التوصيل:* " +
    (shipping === 0 ? "مجاني" : shipping.toFixed(2) + " د.ت") +
    "%0A";

  message += "*الإجمالي:* " +
    total.toFixed(2) +
    " د.ت%0A%0A";

  message += "شكراً لاختياركم عشق ❤️";

  const whatsappNumber = "21627748272";

  const url =
    "https://wa.me/" +
    whatsappNumber +
