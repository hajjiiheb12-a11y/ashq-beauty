let cart = JSON.parse(localStorage.getItem("ashqCart") || "[]");

function saveCart(){
  localStorage.setItem("ashqCart",JSON.stringify(cart));
}

function addToCart(id){

  const product = products.find(p => p.id === id);

  if(!product) return;

  const existing = cart.find(item => item.id === id);

  if(existing){
    existing.qty++;
  }else{
    cart.push({
      id:id,
      qty:1
    });
  }

  saveCart();
  updateCart();

  showToast("تمت إضافة " + product.name + " للسلة ♥");

  /*
    مهم:
    ما فماش openCart() هنا
    يعني المستخدم يبقى في نفس الصفحة
  */
}

function changeQty(id,change){

  const item = cart.find(x => x.id === id);

  if(!item) return;

  item.qty += change;

  if(item.qty <= 0){
    cart = cart.filter(x => x.id !== id);
  }

  saveCart();
  updateCart();
}

function removeFromCart(id){

  cart = cart.filter(x => x.id !== id);

  saveCart();
  updateCart();
}

function cartCount(){

  return cart.reduce((sum,item) => sum + item.qty,0);
}

function updateCart(){

  document.getElementById("cartCount").textContent = cartCount();

  const box = document.getElementById("cartItems");

  if(cart.length === 0){

    box.innerHTML = `
      <div class="empty">
        <div style="font-size:50px">🛍️</div>
        <h3>السلة فارغة</h3>
        <p>اختاري منتجاتك وخلي الباقي علينا ♥</p>
      </div>
    `;

  }else{

    box.innerHTML = cart.map(item => {

      const p = products.find(x => x.id === item.id);

      return `
        <div class="cartItem">

          <img src="${p.image}" alt="${p.name}">

          <div class="cartItemInfo">

            <h4>${p.name}</h4>

            <div class="cartItemPrice">
              ${(p.price * item.qty).toFixed(2)} د.ت
            </div>

            <div class="qty">
              <button onclick="changeQty(${p.id},1)">+</button>
              <strong>${item.qty}</strong>
              <button onclick="changeQty(${p.id},-1)">−</button>

              <button class="remove" onclick="removeFromCart(${p.id})">
                حذف
              </button>
            </div>

          </div>

        </div>
      `;

    }).join("");
  }

  calculateTotals();
}

function calculateTotals(){

  const subtotal = cart.reduce((sum,item) => {

    const p = products.find(x => x.id === item.id);

    return sum + (p.price * item.qty);

  },0);

  const shipping = subtotal === 0 ? 0 : (subtotal >= 80 ? 0 : 8);

  const total = subtotal + shipping;

  document.getElementById("subtotal").textContent =
    subtotal.toFixed(2) + " د.ت";

  document.getElementById("shipping").textContent =
    shipping === 0 ? "مجاني" : shipping.toFixed(2) + " د.ت";

  document.getElementById("total").textContent =
    total.toFixed(2) + " د.ت";
}


