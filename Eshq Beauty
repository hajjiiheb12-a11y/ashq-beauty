function answer(button,category){

  const parent = button.closest(".question");

  parent.querySelectorAll(".answer").forEach(btn => {
    btn.classList.remove("selected");
  });

  button.classList.add("selected");

  quizScores[category]++;

  setTimeout(() => {

    if(quizStep < 5){

      document
        .querySelector(`.question[data-q="${quizStep}"]`)
        .classList.remove("active");

      quizStep++;

      document
        .querySelector(`.question[data-q="${quizStep}"]`)
        .classList.add("active");

    }else{

      finishQuiz();

    }

  },250);
}

function finishQuiz(){

  document.querySelectorAll(".question").forEach(q => {
    q.classList.remove("active");
  });

  const categories = Object.keys(quizScores);

  categories.sort((a,b) => quizScores[b] - quizScores[a]);

  const result = categories[0];

  const names = {
