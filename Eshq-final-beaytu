function saveCart(){

  localStorage.setItem(
    "ashqCart",
    JSON.stringify(cart)
  );

  updateCart();

}


function money(n){

  return Number(n).toFixed(2) + " د.ت";

}


function toast(message){

  const el =
  document.getElementById("toast");

  el.textContent = message;

  el.style.display = "block";

  setTimeout(()=>{
    el.style.display = "none";
  },2200);

}


function addToCart(id){

  const item =
  cart.find(x=>x.id===id);

  if(item){

    item.qty++;

  }else{

    cart.push({
      id:id,
      qty:1
    });

  }

  saveCart();

  toast("تزاد المنتج للسلة ❤️");

}


function changeQty(id,delta){

  const item =
  cart.find(x=>x.id===id);

  if(!item)return;

  item.qty += delta;

  if(item.qty<=0){

    cart =
    cart.filter(x=>x.id!==id);

  }

  saveCart();

}


function removeItem(id){

  cart =
  cart.filter(x=>x.id!==id);

  saveCart();

  toast("تحذف المنتج");

}


/* =========================
   PRODUCTS
========================= */

function imageHtml(p){

  return `
    <img
      src="${p.image}"
      alt="${p.name}"
      loading="lazy"
      onerror="this.onerror=null;this.src='${GITHUB}3600541358447.jpg';"
    >
  `;

}


function renderProducts(){

  const grid =
  document.getElementById("productGrid");

  const list =
  currentCategory==="All"
  ? PRODUCTS
  : PRODUCTS.filter(
      p=>p.category===currentCategory
    );

  grid.innerHTML =
  list.map(p=>`

    <article class="product">

      <div class="product-img">
        ${imageHtml(p)}
      </div>

      <div class="product-info">

        <div class="product-category">
          ${p.category}
        </div>

        <h3>${p.name}</h3>

        <small>${p.brand}</small>

        <p>${p.desc}</p>

        <div class="price">
          ${money(p.price)}
        </div>

        <button
          class="add"
          onclick="addToCart('${p.id}')"
        >
          أضف للسلة 🛍️
        </button>

      </div>

    </article>

  `).join("");

}


function setCat(cat,button){

  currentCategory = cat;

  if(button){

    document
    .querySelectorAll(".chip")
    .forEach(x=>x.classList.remove("active"));

    button.classList.add("active");

  }else{

    document
    .querySelectorAll(".chip")
    .forEach(x=>{

      x.classList.toggle(
        "active",
        x.textContent.includes(cat)
      );

    });

  }

  renderProducts();

}


/* =========================
   CART DISPLAY
========================= */

function totals(){

  const subtotal =
  cart.reduce((sum,item)=>{

    const p =
    PRODUCTS.find(x=>x.id===item.id);

    return sum +
    (p ? p.price * item.qty : 0);

  },0);

  const shipping =
  subtotal===0
  ? 0
  : subtotal>=SHIPPING_LIMIT
  ? 0
  : SHIPPING_FEE;

  return {

    subtotal,
    shipping,
    total:subtotal+shipping

  };

}


function updateCart(){

  const count =
  cart.reduce(
    (sum,item)=>sum+item.qty,
    0
  );

  document.getElementById(
    "cartCount"
  ).textContent = count;


  const box =
  document.getElementById("cartBox");


  if(!cart.length){

    box.innerHTML = `

      <div class="empty">

        السلة فارغة 🛍️

        <br>

        <button
          class="primary"
          onclick="go('products')"
          style="margin-top:15px"
        >
          شوفي المنتجات
        </button>

      </div>

    `;

    updateCheckoutSummary();

    return;

  }


  const t = totals();


  box.innerHTML =

  cart.map(item=>{

    const p =
    PRODUCTS.find(x=>x.id===item.id);

    if(!p)return "";

    return `

      <div class="cart-row">

        <div class="cart-thumb">
          ${imageHtml(p)}
        </div>

        <div>
          <b>${p.name}</b>
          <div class="brand">
            ${money(p.price)}
          </div>
        </div>

        <div class="qty">

          <button
            onclick="changeQty('${p.id}',-1)"
          >
            −
          </button>

          <b>${item.qty}</b>

          <button
            onclick="changeQty('${p.id}',1)"
          >
            +
          </button>

        </div>

        <button
          class="remove"
          onclick="removeItem('${p.id}')"
        >
          حذف
        </button>

      </div>

    `;

  }).join("");


  box.innerHTML += `

    <div class="summary">

      <div class="sumline">
        <span>المجموع الفرعي</span>
        <b>${money(t.subtotal)}</b>
      </div>

      <div class="shipping-note ${t.shipping===0?"free":""}">

        ${
          t.subtotal < SHIPPING_LIMIT
          ? `كمّل ${money(SHIPPING_LIMIT-t.subtotal)}
             والتوصيل علينا 🎁`
          : `🎉 التوصيل علينا`
        }

      </div>

      <div class="sumline">

        <span>التوصيل</span>

        <b>
          ${
            t.shipping===0
            ? "مجاني"
            : money(t.shipping)
          }
        </b>

      </div>

      <div class="sumline total">

        <span>المجموع النهائي</span>

        <b>${money(t.total)}</b>

      </div>

      <button
        class="primary"
        onclick="go('checkout')"
        style="width:100%;margin-top:12px"
      >
        كمّل الطلب 💗
      </button>

    </div>

  `;

  updateCheckoutSummary();

}


/* =========================
   CHECKOUT SUMMARY
========================= */

function updateCheckoutSummary(){

  const el =
  document.getElementById(
    "checkoutSummary"
  );

  if(!el)return;

  if(!cart.length){

    el.innerHTML =
    "<p>السلة فارغة.</p>";

    return;

  }

  const t=totals();

  el.innerHTML = `

    <div class="sumline">
      <span>المجموع الفرعي</span>
      <b>${money(t.subtotal)}</b>
    </div>

    <div class="sumline">
      <span>التوصيل</span>
      <b>
        ${
          t.shipping===0
          ? "مجاني"
          : money(t.shipping)
        }
      </b>
    </div>

    <div class="sumline total">
      <span>المجموع</span>
      <b>${money(t.total)}</b>
    </div>

  `;

}


/* =========================
   WHATSAPP ORDER
========================= */

function sendOrder(e){

  e.preventDefault();

  if(!cart.length){

    toast("السلة فارغة");

    go("products");

    return;

  }


  const name =
  document.getElementById(
    "customerName"
  ).value.trim();

  const phone =
  document.getElementById(
    "customerPhone"
  ).value.trim();

  const gov =
  document.getElementById(
    "governorate"
  ).value;

  const address =
  document.getElementById(
    "address"
  ).value.trim();

  const notes =
  document.getElementById(
    "notes"
  ).value.trim();


  const t=totals();


  let lines = [

    "طلب جديد من موقع عشق ❤️",

    "",

    "🛍️ المنتجات:"

  ];


  cart.forEach(item=>{

    const p =
    PRODUCTS.find(x=>x.id===item.id);

    if(!p)return;

    lines.push(

      `• ${p.name} — ${item.qty} × ${money(p.price)} = ${money(p.price*item.qty)}`

    );

  });


  lines.push(

    "",

    `المجموع الفرعي: ${money(t.subtotal)}`,

    `التوصيل: ${
      t.shipping===0
      ? "مجاني"
      : money(t.shipping)
    }`,

    `المجموع النهائي: ${money(t.total)}`,

    "",

    "👤 معلومات الحريف:",

    `الاسم: ${name}`,

    `الهاتف: ${phone}`,

    `الولاية: ${gov}`,

    `العنوان: ${address}`,

    `ملاحظات: ${notes || "—"}`

  );


  const url =
  "https://wa.me/" +
  WHATSAPP +
  "?text=" +
  encodeURIComponent(
    lines.join("\n")
  );


  window.open(
    url,
    "_blank"
  );


  document.getElementById(
    "success"
  ).style.display="block";


  cart=[];

  saveCart();

  go("success");

}


