    a:[
      ["Glow","Fresh & Glowy"],
      ["Care","Clean & Soft"],
      ["Hair","Healthy Hair"],
      ["Night","Calm Night"]
    ]

  }

];


let qi=0;

let qanswers=[];


function renderQuiz(){

  document.getElementById(
    "questions"
  ).innerHTML =

  quiz.map((item,index)=>`

    <div
      class="q ${index===0?"active":""}"
      data-q="${index}"
    >

      <h3>
        ${index+1}. ${item.q}
      </h3>

      <div class="answers">

        ${item.a.map((answer,index2)=>`

          <button
            class="answer"
            onclick="
              pickAnswer(
                ${index},
                '${answer[0]}',
                this
              )
            "
          >
            ${answer[1]}
          </button>

        `).join("")}

      </div>

    </div>

  `).join("");


  updateQuiz();

}


function pickAnswer(i,val,btn){

  qanswers[i]=val;

  btn.parentElement
  .querySelectorAll(".answer")
  .forEach(x=>{

    x.classList.remove(
      "selected"
    );

  });

  btn.classList.add("selected");

}


function updateQuiz(){

  document
  .querySelectorAll(".q")
  .forEach((x,index)=>{

    x.classList.toggle(
      "active",
      index===qi
    );

  });


  document.getElementById(
    "quizBar"
  ).style.width =

  ((qi+1)/quiz.length*100)+"%";


  document.getElementById(
    "prevQ"
  ).style.visibility =

  qi===0
  ? "hidden"
  : "visible";


  document.getElementById(
    "nextQ"
  ).textContent =

  qi===quiz.length-1
  ? "شوفي النتيجة ✨"
  : "التالي";

}


function nextQuestion(){

  if(!qanswers[qi]){

    toast(
      "اختاري إجابة أولاً ❤️"
    );

    return;

  }


  if(qi<quiz.length-1){

    qi++;

    updateQuiz();

  }else{

    showResult();

  }

}


function prevQuestion(){

  if(qi>0){

    qi--;

    updateQuiz();

  }

}


function showResult(){

  const scores = {

    Glow:0,
    Care:0,
    Hair:0,
    Night:0

  };


  qanswers.forEach(answer=>{

    if(scores[answer]!==undefined){

      scores[answer]++;

    }

  });


  const best =
  Object.keys(scores)
  .sort(
    (a,b)=>
    scores[b]-scores[a]
  )[0];


  const text={

    Glow:
    "روتين Glow ✨ — ركّزي على التنظيف اللطيف والترطيب ومنتجات الإشراقة.",

    Care:
    "روتين Care 🫧 — ابدئي بالتنظيف والترطيب وخلي الروتين بسيط.",

    Hair:
    "روتين Hair 💇‍♀️ — ركّزي على العناية بالشعر واستعمال المنتجات حسب تعليمات العبوة.",

    Night:
    "روتين Night 🌙 — خلي العناية المسائية وقت هادئ للتنظيف والترطيب."

  };


  const result =
  document.getElementById(
    "quizResult"
  );


  result.style.display="block";


  result.innerHTML = `

    <h3>
      النتيجة: ${best}
    </h3>

    <p>
      ${text[best]}
    </p>

    <button
      class="primary"
      onclick="
        setCat('${best}');
        go('products')
      "
    >
      شوفي منتجات ${best}
    </button>

  `;


  document.getElementById(
    "nextQ"
  ).style.display="none";

}


